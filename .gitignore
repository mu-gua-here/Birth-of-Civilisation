.DS_Store

# Godot 4 editor/import cache -- fully regenerable, shouldn't be tracked
.godot/

# Godot editor crash-recovery / autosave scratch files
*.tmp
*.depren
*.import

# Generated translation binaries (fully regenerable)
*.translation

# Native export templates & build artifacts
*.pck
export.cfg

# Exported build artifacts (optional)
*.exe
*.zip
*.apk
*.aab
*.x86_64
*.wasm
